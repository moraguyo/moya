@{
    // CMS 기본 경로 설정
    string layoutPath = "/UserData/mhetest/Layouts/mhetest_Layout";
    string cssFile = layoutPath + "/Contents/Main_test_04.css";
    string jsFile = layoutPath + "/Scripts/Main_test_04.js";
}

<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700&family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Noto+Sans+KR:wght@300;400;700&family=Inter:wght@300;400;600&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons">

<link href="@Url.Content("~" + cssFile)" rel="stylesheet" />

<div class="cms-content-root">
    <!-- Navigation -->
    <nav class="fixed top-0 left-0 w-full z-50 px-8 py-6 flex justify-between items-center mix-blend-difference">
        <div class="text-white uppercase tracking-[0.3em] font-cinzel text-2xl">
            Centennial
        </div>
        <div class="hidden md:flex space-x-8 text-white text-sm tracking-widest uppercase font-sans">
            <a href="#" class="hover:text-gold transition-colors">Heritage</a>
            <a href="#" class="hover:text-gold transition-colors">Archive</a>
            <a href="#" class="hover:text-gold transition-colors">Mission</a>
            <a href="#" class="hover:text-gold transition-colors">Future</a>
        </div>
        <button class="p-2 border border-gold/30 rounded-full md:hidden" id="mobile-menu-btn">
            <span class="material-icons text-gold">menu</span>
        </button>
    </nav>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="fixed inset-0 z-40 bg-black bg-opacity-95 flex items-center justify-center md:hidden" style="display: none;">
        <div class="flex flex-col space-y-8 text-white text-xl tracking-widest uppercase text-center font-sans">
            <a href="#" class="hover:text-gold transition-colors menu-link">Heritage</a>
            <a href="#" class="hover:text-gold transition-colors menu-link">Archive</a>
            <a href="#" class="hover:text-gold transition-colors menu-link">Mission</a>
            <a href="#" class="hover:text-gold transition-colors menu-link">Future</a>
        </div>
    </div>

    <!-- Hero Section -->
    <header class="relative h-screen flex items-center justify-center overflow-hidden bg-black">
        <div class="absolute inset-0 z-0">
            <img src="https://images.unsplash.com/photo-1513326738677-b964603b136d?auto=format&fit=crop&q=80"
                 alt="Heritage"
                 class="w-full h-full object-cover opacity-60 grayscale" />
        </div>
        <div class="absolute inset-0 bg-gradient-to-t from-black via-black/20 to-transparent z-0"></div>
        <div class="relative z-10 text-center px-4">
            <h2 class="text-gold uppercase tracking-[0.3em] mb-4 font-medium animate-fade-in font-sans text-sm">
                Timeline Archive
            </h2>
            <h1 class="text-white mb-8 leading-tight font-bold font-serif hero-title">
                Moments of<br />100 Years
            </h1>
            <p class="text-xl md:text-2xl text-gray-200 font-light max-w-2xl mx-auto font-serif italic">
                A century of faith, excellence, and community heritage.
            </p>
        </div>
        <div class="absolute bottom-12 left-1/2 -translate-x-1/2 animate-bounce z-10">
            <span class="material-icons text-gold text-4xl">expand_more</span>
        </div>
    </header>

    <!-- Intro Section -->
    <section class="relative py-32 px-8 bg-zinc-950">
        <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-20 items-center">
            <div class="space-y-12">
                <div>
                    <p class="text-gold uppercase tracking-widest text-sm font-medium mb-4">Our Legacy</p>
                    <h3 class="text-4xl md:text-5xl font-bold leading-tight font-serif text-white">
                        시간의 흐름 속에 새겨진,<br />100년의 믿음.
                    </h3>
                </div>
                <p class="text-gray-400 leading-relaxed text-lg font-light max-w-xl">
                    침묵 끝에 모인 작은 불씨로부터 현재를 비추는 활기찬 공동체에 이르기까지,
                    우리의 영적 여정을 정의하는 역사적 이정표를 살펴보세요.
                </p>
            </div>
            <div class="relative aspect-[4/5] rounded-2xl overflow-hidden group">
                <img src="https://images.unsplash.com/photo-1759417831863-e6d776fa85c3?auto=format&fit=crop&q=80"
                     class="absolute inset-0 w-full h-full object-cover grayscale transition-transform duration-700 group-hover:scale-105" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent"></div>
                <div class="absolute bottom-8 left-8">
                    <p class="text-gold text-sm tracking-widest mb-2 font-medium">EST. 1924</p>
                    <h4 class="text-white text-2xl font-bold font-serif">The Foundation</h4>
                </div>
            </div>
        </div>
    </section>

    <!-- Scrollable Timeline Section -->
    <div id="timeline-scroll-container" class="relative bg-black">
        <div id="sticky-viewport" class="sticky top-0 h-screen flex flex-col justify-center px-8 md:px-24 overflow-hidden">
            <!-- Background Layer -->
            <div class="absolute inset-0 z-0 pointer-events-none">
                <div id="bg-layer-current" class="absolute inset-0 transition-opacity duration-1000">
                    <img id="current-bg-img" src="" alt="" class="w-full h-full object-cover grayscale opacity-40" />
                    <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-transparent to-black"></div>
                </div>
                <div id="bg-layer-next" class="absolute inset-0 transition-opacity duration-1000" style="opacity: 0;">
                    <img id="next-bg-img" src="" alt="" class="w-full h-full object-cover grayscale opacity-40" />
                    <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-transparent to-black"></div>
                </div>
            </div>

            <!-- Content Layer -->
            <div id="content-container" class="relative z-10 w-full">
                <!-- Dynamic content injected by JS -->
            </div>

            <!-- Dark Overlay for transition -->
            <div id="dark-overlay" class="absolute inset-0 z-20 bg-black pointer-events-none" style="opacity: 0;"></div>
        </div>
    </div>

    <!-- Video Section -->
    <section id="video-section" class="relative bg-white py-32 px-8 z-30 opacity-0 transform translate-y-20 transition-all duration-700">
        <div class="max-w-7xl mx-auto">
            <div class="mb-16">
                <p class="text-gold text-sm tracking-widest uppercase mb-4 font-medium">100주년 기념 영상 시리즈</p>
                <h3 class="text-4xl md:text-5xl font-bold font-serif text-black">
                    세기의 목소리
                </h3>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
                <div class="group cursor-pointer">
                    <div class="relative aspect-video overflow-hidden rounded-3xl mb-6 shadow-2xl">
                        <img src="https://images.unsplash.com/photo-1762777125835-fb9833fb931e?auto=format&fit=crop&q=80" class="w-full h-full object-cover grayscale transition-all duration-500 group-hover:scale-105" />
                        <div class="absolute inset-0 bg-black/20 group-hover:bg-transparent transition-colors"></div>
                        <div class="absolute bottom-6 right-6 w-12 h-12 bg-white rounded-full flex items-center justify-center shadow-lg">
                            <span class="material-icons text-black">play_arrow</span>
                        </div>
                    </div>
                    <p class="text-gold text-xs tracking-widest uppercase mb-2 font-medium">Episode 01</p>
                    <h5 class="text-2xl font-bold text-black font-serif">첫 번째 비전가</h5>
                </div>
                <div class="group cursor-pointer">
                    <div class="relative aspect-video overflow-hidden rounded-3xl mb-6 shadow-2xl">
                        <img src="https://images.unsplash.com/photo-1768321611052-970d36fd6571?auto=format&fit=crop&q=80" class="w-full h-full object-cover grayscale transition-all duration-500 group-hover:scale-105" />
                        <div class="absolute inset-0 bg-black/20 group-hover:bg-transparent transition-colors"></div>
                        <div class="absolute bottom-6 right-6 w-12 h-12 bg-white rounded-full flex items-center justify-center shadow-lg">
                            <span class="material-icons text-black">play_arrow</span>
                        </div>
                    </div>
                    <p class="text-gold text-xs tracking-widest uppercase mb-2 font-medium">Episode 02</p>
                    <h5 class="text-2xl font-bold text-black font-serif">위대한 모임</h5>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="bg-black text-white py-32 px-8 border-t border-gray-800">
        <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-20">
            <div class="md:col-span-2 space-y-8">
                <h2 class="text-gold uppercase tracking-[0.3em] font-cinzel text-3xl">
                    Centennial
                </h2>
                <p class="text-gray-400 max-w-sm font-light leading-relaxed text-lg">
                    100년의 믿음과 소망, 그리고 사랑을 기념합니다. 1924년에 설립되어, 우리는 함께 다음 세기를 향해 나아갑니다.
                </p>
            </div>
            <div>
                <h6 class="text-xs font-bold uppercase tracking-widest text-gold mb-8">Archive</h6>
                <ul class="space-y-6 text-sm text-gray-400 font-sans">
                    <li><a href="#" class="hover:text-white transition-colors">역사 자료</a></li>
                    <li><a href="#" class="hover:text-white transition-colors">사진 갤러리</a></li>
                    <li><a href="#" class="hover:text-white transition-colors">구술 기록</a></li>
                    <li><a href="#" class="hover:text-white transition-colors">연혁</a></li>
                </ul>
            </div>
            <div>
                <h6 class="text-xs font-bold uppercase tracking-widest text-gold mb-8">Connect</h6>
                <div class="flex space-x-4 mb-8">
                    <a href="#" class="w-12 h-12 rounded-full border border-gray-800 flex items-center justify-center hover:bg-gold hover:border-gold transition-all duration-500">
                        <span class="material-icons text-white group-hover:text-black">public</span>
                    </a>
                    <a href="#" class="w-12 h-12 rounded-full border border-gray-800 flex items-center justify-center hover:bg-gold hover:border-gold transition-all duration-500">
                        <span class="material-icons text-white group-hover:text-black">email</span>
                    </a>
                </div>
                <p class="text-xs text-gray-500 leading-loose">
                    © 2024 Centennial Church Heritage Society.<br />All rights reserved.
                </p>
            </div>
        </div>
    </footer>
</div>

<script src="@Url.Content("~" + jsFile)"></script>
